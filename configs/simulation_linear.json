      "label": "A",
      "name": "low_rank_direction_outlier",
      "params": {
        "eps": 0.1,
        "rank": 1,
        "scale": 30.0,
        "sigma": 1.0,
        "standardize": "global",
        "tail": "centered_lognormal"
      }
    },
    {
      "label": "B",
      "name": "low_rank_direction_outlier",
      "params": {
        "alpha": 2.5,
        "eps": 0.1,
        "rank": 3,
        "scale": 20.0,
        "standardize": "global",
        "tail": "centered_pareto"
      }
    },
    {
      "label": "C",
      "name": "eight_cluster",
